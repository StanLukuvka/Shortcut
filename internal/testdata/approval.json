        {
          "path": ".shortcuts",
          "type": "file",
          "content": "{\n  \"shortcuts\": {\n    \"hi\": {\n      \"script\": \"scripts/hi.sh\"\n    },\n    \"inline\": {\n      \"inline\": \"echo \\u00e9\"\n    }\n  },\n  \"version\": 1\n}\n",
          "mode": "0o644"
        },
        {
          "path": "scripts/hi.sh",
          "type": "file",
          "content": "#!/usr/bin/env bash\necho hi\n",
          "mode": "0o755"
