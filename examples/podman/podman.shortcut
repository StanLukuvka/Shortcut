{
  "version": 1,
  "shortcuts": {
    "ps": {
      "description": "All containers, with status, image and ports. Flags pass to podman ps",
      "inline": "podman ps -a --format \"table {{.Names}}\\t{{.Status}}\\t{{.Image}}\\t{{.Ports}}\" \"$@\""
    },
    "images": {
      "description": "Images, newest first.",
      "inline": "podman images --sort created \"$@\""
    },
    "stats": {
      "description": "CPU and memory of running containers, once",
      "inline": "podman stats --no-stream \"$@\""
    },
    "logs": {
      "description": "Follow a container's logs (the picked one by default)",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current \"${1:-}\") && podman logs -f --tail \"${2:-100}\" \"$c\""
    },
    "sh": {
      "description": "Shell in a container (the picked one by default)",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current \"${1:-}\") && podman exec -it \"$c\" sh -c \"command -v bash >/dev/null && exec bash || exec sh\""
    },
    "restart": {
      "description": "Restart a container (the picked one by default)",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current \"${1:-}\") && podman restart \"$c\""
    },
    "run": {
      "description": "Run a new container. Flags and the image pass to podman run",
      "inline": "podman run \"$@\""
    },
    "create": {
      "description": "Create a container without starting it. Flags and the image pass to podman create",
      "inline": "podman create \"$@\""
    },
    "start": {
      "description": "Start containers by name, or this terminal's pick when none are given",
      "inline": "if [ $# -eq 0 ]; then c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current) || exit; set -- \"$c\"; fi; podman start \"$@\""
    },
    "inspect": {
      "description": "Inspect a container (the picked one by default)",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current \"${1:-}\") && podman inspect \"$c\""
    },
    "pause": {
      "description": "Pause a container (the picked one by default)",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current \"${1:-}\") && podman pause \"$c\""
    },
    "unpause": {
      "description": "Unpause a container (the picked one by default)",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current \"${1:-}\") && podman unpause \"$c\""
    },
    "kill": {
      "description": "Kill a container (the picked one by default)",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current \"${1:-}\") && podman kill \"$c\""
    },
    "rm": {
      "description": "Remove a container (the picked one by default)",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current \"${1:-}\") && podman rm \"$c\""
    },
    "top": {
      "description": "Processes of a container (the picked one by default). Later words are ps fields",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current \"${1:-}\") || exit; shift $(($# > 0)); podman top \"$c\" \"$@\""
    },
    "cp": {
      "description": "Copy files between a container and the host: shortcut r podman cp web:/etc/hosts .",
      "inline": "podman cp \"$1\" \"$2\""
    },
    "ports": {
      "description": "Port mappings of a container (the picked one by default)",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current \"${1:-}\") && podman port \"$c\""
    },
    "up": {
      "description": "podman compose up -d in this folder",
      "inline": "podman compose up -d \"$@\""
    },
    "down": {
      "description": "podman compose down in this folder",
      "inline": "podman compose down \"$@\""
    },
    "clogs": {
      "description": "Follow the logs of this folder's compose project",
      "inline": "podman compose logs -f --tail 100 \"$@\""
    },
    "prune": {
      "description": "Remove stopped containers, unused networks and dangling images. Keeps your images",
      "inline": "podman system prune -f",
      "confirm": true
    },
    "nuke": {
      "description": "Remove every stopped container and every unused image and volume",
      "inline": "podman system prune -af --volumes",
      "confirm": true
    },
    "list": {
      "description": "Numbered list of all containers; * marks the one picked in this terminal",
      "script": "scripts/podman/list.sh"
    },
    "use": {
      "description": "Pick a container for this terminal by number from list, or by name. No argument: show the pick's row. none: clear it",
      "script": "scripts/podman/use.sh"
    },
    "current": {
      "description": "Print the container a number, a name or this terminal's pick refers to: its list row on a terminal, its name when captured",
      "script": "scripts/podman/current.sh"
    },
    "exec": {
      "description": "Run a command in this terminal's picked container: shortcut r podman exec -- ls -la",
      "inline": "c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current) || exit; t=; [ -t 0 ] && t=-t; podman exec -i $t \"$c\" \"$@\""
    },
    "stop": {
      "description": "Stop containers by name, or this terminal's pick when none are given",
      "inline": "if [ $# -eq 0 ]; then c=$(SHORTCUT_SHOW_DIR=0 shortcut r \"$SHORTCUT_NAMESPACE\" current) || exit; set -- \"$c\"; fi; podman stop \"$@\""
    },
    "pods": {
      "description": "Pods and their containers",
      "inline": "podman pod ps \"$@\""
    },
    "health": {
      "description": "Health check status of each running container",
      "script": "scripts/podman/health.sh"
    }
  }
}
