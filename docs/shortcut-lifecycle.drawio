<mxfile host="app.diagrams.net"><diagram name="Lifecycle"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2060" pageHeight="1480" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;The lifecycle of a shortcut or group&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1200" height="34" as="geometry"/></mxCell><mxCell id="sub" value="From entering a store, through review, run and log, to change and re-approval or removal. shortcut 2.0.0, commit 9604209." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1500" height="22" as="geometry"/></mxCell><mxCell id="L1" value="&lt;b&gt;1 Enter&lt;/b&gt;&lt;br&gt;Who: a person or an agent.&lt;br&gt;The content can come from anyone." style="swimlane;horizontal=0;startSize=110;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;collapsible=0;fillColor=none;strokeColor=#999999;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="1980" height="214" as="geometry"/></mxCell><mxCell id="L2" value="&lt;b&gt;2 Review and approve&lt;/b&gt;&lt;br&gt;Who: a person at a terminal,&lt;br&gt;or anyone who passes -y." style="swimlane;horizontal=0;startSize=110;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;collapsible=0;fillColor=none;strokeColor=#999999;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="308" width="1980" height="272" as="geometry"/></mxCell><mxCell id="L3" value="&lt;b&gt;3 List and run&lt;/b&gt;&lt;br&gt;Who: a person or an agent asks.&lt;br&gt;shortcut enforces." style="swimlane;horizontal=0;startSize=110;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;collapsible=0;fillColor=none;strokeColor=#999999;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1980" height="268" as="geometry"/></mxCell><mxCell id="L4" value="&lt;b&gt;4 Log and diagnose&lt;/b&gt;&lt;br&gt;Who: shortcut writes.&lt;br&gt;A person or an agent reads." style="swimlane;horizontal=0;startSize=110;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;collapsible=0;fillColor=none;strokeColor=#999999;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="868" width="1980" height="232" as="geometry"/></mxCell><mxCell id="L5" value="&lt;b&gt;5 Change and remove&lt;/b&gt;&lt;br&gt;Who: a person, an agent,&lt;br&gt;or whoever wrote a pull." style="swimlane;horizontal=0;startSize=110;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;collapsible=0;fillColor=none;strokeColor=#999999;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="1980" height="244" as="geometry"/></mxCell><mxCell id="GA" value="&lt;b&gt;Gated: arrives in a project store or a namespace&lt;/b&gt;" style="swimlane;startSize=24;html=1;whiteSpace=wrap;fontSize=12;collapsible=0;fillColor=none;strokeColor=#999999;rounded=1;arcSize=3;" vertex="1" parent="L1"><mxGeometry x="165" y="12" width="1130" height="190" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;new, add, link&lt;/b&gt;&lt;br&gt;with --local or --group.&lt;br&gt;A group in the global store is gated too. Without a terminal, no editor opens." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="GA"><mxGeometry x="12" y="32" width="176" height="146" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;init&lt;/b&gt;&lt;br&gt;Makes an empty project store with its .gitignore." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="GA"><mxGeometry x="198" y="32" width="176" height="146" as="geometry"/></mxCell><mxCell id="a3" value="&lt;b&gt;git clone, git pull&lt;/b&gt;&lt;br&gt;The project store is read in place. Nothing is copied or run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=4;" vertex="1" parent="GA"><mxGeometry x="384" y="32" width="176" height="146" as="geometry"/></mxCell><mxCell id="a4" value="&lt;b&gt;Add a .shortcut file&lt;/b&gt;&lt;br&gt;In imports/, or named in &amp;quot;imports&amp;quot;, which may point outside the project." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=4;" vertex="1" parent="GA"><mxGeometry x="570" y="32" width="176" height="146" as="geometry"/></mxCell><mxCell id="a5" value="&lt;b&gt;Move the project&lt;/b&gt;&lt;br&gt;Approval is keyed by real path, so a moved project is new again. So is a namespace file that moved." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="GA"><mxGeometry x="756" y="32" width="176" height="146" as="geometry"/></mxCell><mxCell id="a6" value="&lt;b&gt;migrate&lt;/b&gt;&lt;br&gt;Converts 1.x stores, global and nearest project. 1.x approvals don&amp;#39;t carry over." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="GA"><mxGeometry x="942" y="32" width="176" height="146" as="geometry"/></mxCell><mxCell id="GB" value="&lt;b&gt;Not gated: arrives in the global main file&lt;/b&gt;" style="swimlane;startSize=24;html=1;whiteSpace=wrap;fontSize=12;collapsible=0;fillColor=none;strokeColor=#999999;rounded=1;arcSize=3;" vertex="1" parent="L1"><mxGeometry x="1310" y="12" width="400" height="190" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;new, add, link&lt;/b&gt;&lt;br&gt;The default, with no flags." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="GB"><mxGeometry x="12" y="32" width="150" height="146" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;init --global SOURCE&lt;/b&gt;&lt;br&gt;Folder or git URL. Copies main entries only and runs nothing. Skips and reports: invalid or taken names, invalid entries, symlinks, escapes, linked or missing scripts, unusable cwd." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=4;" vertex="1" parent="GB"><mxGeometry x="172" y="32" width="216" height="146" as="geometry"/></mxCell><mxCell id="global" value="&lt;b&gt;Global main&lt;/b&gt;&lt;br&gt;No approval state. Runnable at once." style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="L1"><mxGeometry x="1750" y="67" width="170" height="80" as="geometry"/></mxCell><mxCell id="new" value="&lt;b&gt;new&lt;/b&gt;&lt;br&gt;No approval record" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="L2"><mxGeometry x="175" y="40" width="150" height="70" as="geometry"/></mxCell><mxCell id="update" value="&lt;b&gt;shortcut update [group] [-y]&lt;/b&gt;&lt;br&gt;No group: all pending here" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="L2"><mxGeometry x="375" y="40" width="170" height="70" as="geometry"/></mxCell><mxCell id="g1" value="File and entries valid?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L2"><mxGeometry x="590" y="25" width="170" height="100" as="geometry"/></mxCell><mxCell id="g2" value="Hash differs from approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L2"><mxGeometry x="805" y="25" width="170" height="100" as="geometry"/></mxCell><mxCell id="diff" value="Shows the diff against the snapshot, all of it the first time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=4;" vertex="1" parent="L2"><mxGeometry x="1020" y="40" width="160" height="70" as="geometry"/></mxCell><mxCell id="g3" value="-y, or a terminal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L2"><mxGeometry x="1225" y="25" width="150" height="100" as="geometry"/></mxCell><mxCell id="g4" value="Answer y?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L2"><mxGeometry x="1455" y="25" width="140" height="100" as="geometry"/></mxCell><mxCell id="save" value="Saves key, hash and snapshot to approvals/ in the global store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=4;" vertex="1" parent="L2"><mxGeometry x="1645" y="40" width="200" height="70" as="geometry"/></mxCell><mxCell id="ru1" value="&lt;b&gt;cannot approve&lt;/b&gt;&lt;br&gt;Broken file, invalid entry or missing script. Exit 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L2"><mxGeometry x="590" y="178" width="170" height="72" as="geometry"/></mxCell><mxCell id="ru2" value="&lt;b&gt;already approved&lt;/b&gt;&lt;br&gt;Nothing is written." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=4;" vertex="1" parent="L2"><mxGeometry x="805" y="178" width="170" height="72" as="geometry"/></mxCell><mxCell id="ru3" value="&lt;b&gt;approve in a terminal,&lt;br&gt;or pass -y&lt;/b&gt;&lt;br&gt;Exit 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L2"><mxGeometry x="1225" y="178" width="150" height="72" as="geometry"/></mxCell><mxCell id="ru4" value="&lt;b&gt;Not approved.&lt;/b&gt;&lt;br&gt;Exit 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L2"><mxGeometry x="1450" y="178" width="150" height="72" as="geometry"/></mxCell><mxCell id="ok" value="&lt;b&gt;ok&lt;/b&gt;&lt;br&gt;Hash matches the approval" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="L2"><mxGeometry x="1660" y="178" width="170" height="72" as="geometry"/></mxCell><mxCell id="list" value="&lt;b&gt;list, Tab&lt;/b&gt;&lt;br&gt;Shows ok groups and global main. Others: one line saying to review them. Tab: ok only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="L3"><mxGeometry x="1680" y="42" width="190" height="86" as="geometry"/></mxCell><mxCell id="run" value="&lt;b&gt;shortcut r NAME [args]&lt;/b&gt;&lt;br&gt;r -y skips confirm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="L3"><mxGeometry x="1455" y="50" width="165" height="70" as="geometry"/></mxCell><mxCell id="r1" value="Name found, store clean?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L3"><mxGeometry x="1270" y="35" width="150" height="100" as="geometry"/></mxCell><mxCell id="r2" value="Group approved? Global main passes." style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=3;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L3"><mxGeometry x="1085" y="35" width="150" height="100" as="geometry"/></mxCell><mxCell id="r3" value="Args present, count OK?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L3"><mxGeometry x="900" y="35" width="150" height="100" as="geometry"/></mxCell><mxCell id="r4" value="Run directory exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L3"><mxGeometry x="715" y="35" width="150" height="100" as="geometry"/></mxCell><mxCell id="r5" value="confirm: yes or -y?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L3"><mxGeometry x="530" y="35" width="150" height="100" as="geometry"/></mxCell><mxCell id="r6" value="Script exists?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L3"><mxGeometry x="380" y="35" width="116" height="100" as="geometry"/></mxCell><mxCell id="exec" value="&lt;b&gt;Runs the entry&lt;/b&gt;&lt;br&gt;Env inherited, plus SHORTCUT_NAME, SHORTCUT_CALLER_CWD, SC_ARG_*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=4;" vertex="1" parent="L3"><mxGeometry x="175" y="38" width="170" height="94" as="geometry"/></mxCell><mxCell id="rr1" value="&lt;b&gt;Not found&lt;/b&gt;, a bare namespace, or a store or entry error. Exit 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L3"><mxGeometry x="1267" y="176" width="156" height="80" as="geometry"/></mxCell><mxCell id="rr2" value="&lt;b&gt;new or changed:&lt;/b&gt; refused, naming shortcut update.&lt;br&gt;Exit 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L3"><mxGeometry x="1082" y="176" width="156" height="80" as="geometry"/></mxCell><mxCell id="rr3" value="&lt;b&gt;usage:&lt;/b&gt; line. A required arg is missing, or too many. Exit 2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L3"><mxGeometry x="897" y="176" width="156" height="80" as="geometry"/></mxCell><mxCell id="rr4" value="&lt;b&gt;Run directory does not exist.&lt;/b&gt; Exit 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L3"><mxGeometry x="712" y="176" width="156" height="80" as="geometry"/></mxCell><mxCell id="rr5" value="&lt;b&gt;No terminal:&lt;/b&gt; error. &lt;b&gt;N:&lt;/b&gt; Aborted. Exit 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L3"><mxGeometry x="527" y="176" width="156" height="80" as="geometry"/></mxCell><mxCell id="rr6" value="&lt;b&gt;Script file not found&lt;/b&gt;, or the entry has neither inline nor script. Exit 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L3"><mxGeometry x="360" y="176" width="156" height="80" as="geometry"/></mxCell><mxCell id="l1" value="log: false?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L4"><mxGeometry x="185" y="30" width="150" height="92" as="geometry"/></mxCell><mxCell id="tee" value="&lt;b&gt;Tees output to the store&amp;#39;s logs/ folder&lt;/b&gt;&lt;br&gt;Through a pty on one foreground terminal, else a pipe, which merges stderr into stdout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=4;" vertex="1" parent="L4"><mxGeometry x="410" y="36" width="270" height="80" as="geometry"/></mxCell><mxCell id="direct" value="No log, no footer. The output goes straight through." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=4;" vertex="1" parent="L4"><mxGeometry x="185" y="152" width="150" height="56" as="geometry"/></mxCell><mxCell id="f1" value="&lt;b&gt;Log can&amp;#39;t open:&lt;/b&gt; the script never starts. Exit 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L4"><mxGeometry x="410" y="144" width="130" height="66" as="geometry"/></mxCell><mxCell id="f2" value="&lt;b&gt;Log write fails:&lt;/b&gt; the script is stopped. Exit 1." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L4"><mxGeometry x="550" y="144" width="130" height="66" as="geometry"/></mxCell><mxCell id="end" value="&lt;b&gt;Footer: === exit: N ===&lt;/b&gt;&lt;br&gt;shortcut exits with N, or 128+N after a signal. A run never changes the state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=4;" vertex="1" parent="L4"><mxGeometry x="750" y="36" width="290" height="80" as="geometry"/></mxCell><mxCell id="diag" value="&lt;b&gt;fix [name], show, r log&lt;/b&gt;&lt;br&gt;Definition, last log, last exit code, and a report per file: ok, not approved, changed since approved, or BROKEN. They work in every state, approved or not." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="L4"><mxGeometry x="1240" y="28" width="370" height="96" as="geometry"/></mxCell><mxCell id="rm" value="&lt;b&gt;shortcut rm NAME [-y]&lt;/b&gt;&lt;br&gt;Works in every state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="L5"><mxGeometry x="1290" y="26" width="170" height="66" as="geometry"/></mxCell><mxCell id="g8" value="-y, or a terminal and y?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="L5"><mxGeometry x="1080" y="14" width="160" height="90" as="geometry"/></mxCell><mxCell id="rm2" value="&lt;b&gt;Removes&lt;/b&gt; the entry, its stored script, its log and any desktop launcher. The approval record stays: no command removes one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=4;" vertex="1" parent="L5"><mxGeometry x="750" y="20" width="280" height="78" as="geometry"/></mxCell><mxCell id="gone" value="&lt;b&gt;Name gone&lt;/b&gt;" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="L5"><mxGeometry x="520" y="26" width="170" height="66" as="geometry"/></mxCell><mxCell id="rr8" value="&lt;b&gt;No terminal:&lt;/b&gt; error, exit 1. &lt;b&gt;N:&lt;/b&gt; Aborted, exit 0." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="L5"><mxGeometry x="1080" y="122" width="160" height="50" as="geometry"/></mxCell><mxCell id="changed" value="&lt;b&gt;changed&lt;/b&gt;&lt;br&gt;Hash differs. Only this group is blocked." style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="L5"><mxGeometry x="175" y="140" width="170" height="74" as="geometry"/></mxCell><mxCell id="change" value="&lt;b&gt;Something changes&lt;/b&gt;&lt;br&gt;edit, new, add, link, a hand edit, or a pull. Reformatting keeps the hash." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=4;" vertex="1" parent="L5"><mxGeometry x="1550" y="138" width="240" height="80" as="geometry"/></mxCell><mxCell id="lg" value="" style="rounded=0;html=1;fillColor=none;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1366" width="1980" height="92" as="geometry"/></mxCell><mxCell id="lgt" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="52" y="1372" width="90" height="24" as="geometry"/></mxCell><mxCell id="k1" value="State" style="rounded=1;arcSize=35;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="1372" width="112" height="34" as="geometry"/></mxCell><mxCell id="k2" value="Person or agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="234" y="1372" width="112" height="34" as="geometry"/></mxCell><mxCell id="k3" value="Outside content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="358" y="1372" width="112" height="34" as="geometry"/></mxCell><mxCell id="k4" value="shortcut acts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="482" y="1372" width="112" height="34" as="geometry"/></mxCell><mxCell id="k5" value="Gate" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="606" y="1367" width="112" height="44" as="geometry"/></mxCell><mxCell id="k6" value="Refused or failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;spacing=4;" vertex="1" parent="1"><mxGeometry x="730" y="1372" width="112" height="34" as="geometry"/></mxCell><mxCell id="k7" value="Thick gate: the approval decision. Thick line: the re-approval loop. Red line: refusal or failure.&lt;br&gt;Dashed line: passes with no check. An unlabelled line out of a gate means yes." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="110" y="1414" width="738" height="34" as="geometry"/></mxCell><mxCell id="k8" value="&lt;b&gt;What approval covers.&lt;/b&gt; The hash is over the file&amp;#39;s parsed JSON, plus the bytes of each file named by script. A hash is kept per group: each project&amp;#39;s main file and each namespace.&lt;br&gt;&lt;b&gt;What it doesn&amp;#39;t cover.&lt;/b&gt; Logs, what a cwd points at, what an inline command or script calls, sources or reads, and the environment. Global main is never hashed, and a global link target can change freely." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="870" y="1370" width="1140" height="82" as="geometry"/></mxCell><mxCell id="e1" value="unapproved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;exitX=0.075;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="GA" target="new" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="GB" target="global" parent="L1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="review" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;" edge="1" source="new" target="update" parent="L2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;" edge="1" source="update" target="g1" parent="L2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;" edge="1" source="g1" target="g2" parent="L2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;" edge="1" source="g2" ta