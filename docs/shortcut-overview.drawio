<mxfile host="app.diagrams.net"><diagram name="1 Structure"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;shortcut 2.0: project structure&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1360" height="36" as="geometry"/></mxCell><mxCell id="c3" value="What lives in the repository, what gets installed, and where shortcuts are stored." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1360" height="26" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;This repository&lt;/b&gt;" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=none;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="330" height="640" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;shortcut.py&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The whole CLI: one Python file, no dependencies" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="44" width="300" height="62" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;install.sh&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Copies shortcut.py to ~/.local/bin and sets up completion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="117" width="300" height="62" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;pyproject.toml&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Packaging for uv tool install and pipx" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="190" width="300" height="62" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;tests/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The test suite (unittest), on one fixture hub" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="263" width="300" height="62" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;templates/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Bundled shortcuts: edit, nano, logged, desktop, search" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="336" width="300" height="62" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;README.md, AGENT.md&lt;/font&gt;&lt;/b&gt;&lt;br&gt;User docs and agent guide" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="409" width="300" height="62" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;.github/workflows/test.yml&lt;/font&gt;&lt;/b&gt;&lt;br&gt;CI: tests on Python 3.10 to 3.14, install checks" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="482" width="300" height="62" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;docs/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Diagrams, icon, schema and design critique" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="555" width="300" height="62" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Installed on your computer&lt;/b&gt;" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=none;collapsible=0;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="330" height="340" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;~/.local/share/bash-completion/...&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Tab completion (fish too, if installed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c13"><mxGeometry x="15" y="44" width="300" height="62" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;~/.local/bin/shortcut&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The command you type: a copy of shortcut.py, or a uv/pipx launcher" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c13"><mxGeometry x="15" y="118" width="300" height="122" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;~/.local/share/applications/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;shortcut-&amp;lt;name&amp;gt;.desktop, made by the bundled desktop shortcut" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c13"><mxGeometry x="15" y="252" width="300" height="62" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;A project: &amp;lt;project&amp;gt;/&lt;/b&gt;" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=none;collapsible=0;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="420" height="280" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;.shortcuts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Shared and committed, edited by hand" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c17"><mxGeometry x="15" y="44" width="390" height="56" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;.shortcuts.local&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Personal, laid over .shortcuts, kept out of git" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c17"><mxGeometry x="15" y="108" width="390" height="56" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;&amp;lt;namespace&amp;gt;.shortcut&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Anywhere, listed under &quot;imports&quot;, run as shortcut r docker delete" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c17"><mxGeometry x="15" y="172" width="390" height="42" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;any script it names, e.g. tools/test.sh&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Relative paths start at the project root" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c17"><mxGeometry x="15" y="222" width="390" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Global store: ~/.shortcuts&lt;/b&gt;" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=none;collapsible=0;" vertex="1" parent="1"><mxGeometry x="960" y="460" width="420" height="380" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;shortcuts.json&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Your entries" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c22"><mxGeometry x="15" y="44" width="390" height="56" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;imports/&amp;lt;namespace&amp;gt;.shortcut&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Namespaces, approved like a project&#x27;s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c22"><mxGeometry x="15" y="108" width="390" height="56" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;approvals/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Per group: the approved hash and a snapshot to diff against" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c22"><mxGeometry x="15" y="172" width="390" height="56" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;scripts/&amp;lt;name&amp;gt;.sh&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Stored script copies" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c22"><mxGeometry x="15" y="236" width="390" height="56" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;locks/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;One lock file per project, so its root stays clean" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c22"><mxGeometry x="15" y="300" width="390" height="56" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Reading the arrows&lt;/b&gt;&lt;br&gt;Solid: a file is copied, or read and written.&lt;br&gt;Dashed: checked against, not changed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Two places&lt;/b&gt;&lt;br&gt;Global store: visible everywhere.&lt;br&gt;Project: visible only inside it.&lt;br&gt;Projects and namespaces run only after &lt;font face=&quot;monospace&quot;&gt;shortcut update&lt;/font&gt; approves them." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="510" width="330" height="190" as="geometry"/></mxCell><mxCell id="c29" value="copies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" source="c6" target="c15" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="uv tool / pipx" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" source="c7" target="c15" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="init --global" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.02;entryDx=0;entryDy=0;" edge="1" source="c9" target="c22" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="reads in place" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.554;entryDx=0;entryDy=0;" edge="1" source="c15" target="c17" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="reads, writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="c15" target="c22" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="322"/><mxPoint x="895" y="420"/><mxPoint x="1170" y="420"/></Array></mxGeometry></mxCell><mxCell id="c34" value="hash of" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="c25" target="c18" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1405" y="660"/><mxPoint x="1405" y="172"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2 How a name runs"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;What happens when you type shortcut r &amp;lt;name&amp;gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1340" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Searched nearest first: project, then global store. --global skips the project. Each gate has to pass before anything runs." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1340" height="26" as="geometry"/></mxCell><mxCell id="c4" value="&lt;font face=&quot;monospace&quot;&gt;shortcut r [--global] [-y] &amp;lt;name&amp;gt; [args]&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="320" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Found in the project, or as a namespace there?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="190" width="220" height="100" as="geometry"/></mxCell><mxCell id="c6" value="Found in the global store, or as a namespace there?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="325" width="220" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Error&lt;/b&gt;: not found" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="345" width="190" height="60" as="geometry"/></mxCell><mxCell id="c8" value="Group approved and unchanged?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="460" width="220" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Refused&lt;/b&gt;, only this group:&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;docker changed since you approved it; run: shortcut update docker&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="465" width="280" height="90" as="geometry"/></mxCell><mxCell id="c10" value="Declared arguments fit?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="595" width="220" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Refused&lt;/b&gt;, exit 2:&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;usage: shortcut r kill &amp;lt;container&amp;gt; [signal]&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="600" width="280" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font face=&quot;monospace&quot;&gt;confirm&lt;/font&gt; set? Then &lt;font face=&quot;monospace&quot;&gt;-y&lt;/font&gt; or a yes" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="720" width="220" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Refused&lt;/b&gt;: answered no, or no terminal and no -y" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="730" width="280" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Run it&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="845" width="180" height="50" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c4" target="c5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c5" target="c6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c6" target="c8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c8" target="c10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c10" target="c12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c12" target="c14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c6" target="c7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c8" target="c9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c10" target="c11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c12" target="c13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="c5" target="c8" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="240"/><mxPoint x="70" y="510"/></Array></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;Then every shortcut runs the same way&lt;/b&gt;" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=none;collapsible=0;" vertex="1" parent="1"><mxGeometry x="790" y="105" width="590" height="800" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;1. Work out the directory&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;cwd&lt;/font&gt; is &lt;font face=&quot;monospace&quot;&gt;caller&lt;/font&gt; (the default): your current directory.&lt;br&gt;A relative path: from the folder of the file that defines it, so &lt;font face=&quot;monospace&quot;&gt;.&lt;/font&gt; is a project's root.&lt;br&gt;An absolute path: that directory." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="c26"><mxGeometry x="20" y="46" width="550" height="140" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;2. Show it&lt;/b&gt;&lt;br&gt;Prints &lt;font face=&quot;monospace&quot;&gt;→ /the/run/dir&lt;/font&gt; in dim text on stderr. &lt;font face=&quot;monospace&quot;&gt;SHORTCUT_SHOW_DIR=0&lt;/font&gt; hides it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="c26"><mxGeometry x="20" y="206" width="550" height="100" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;3. Build the command&lt;/b&gt;&lt;br&gt;Inline: &lt;font face=&quot;monospace&quot;&gt;bash -c&lt;/font&gt; with your arguments as &lt;font face=&quot;monospace&quot;&gt;$1&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;$2&lt;/font&gt;...&lt;br&gt;Script with +x and &lt;font face=&quot;monospace&quot;&gt;#!&lt;/font&gt;, or a binary: runs directly.&lt;br&gt;Script with &lt;font face=&quot;monospace&quot;&gt;#!&lt;/font&gt; but no +x: runs with that interpreter.&lt;br&gt;Anything else: &lt;font face=&quot;monospace&quot;&gt;bash &amp;lt;script&amp;gt;&lt;/font&gt;.&lt;br&gt;Declared arguments also arrive as &lt;font face=&quot;monospace&quot;&gt;SC_ARG_&amp;lt;NAME&amp;gt;&lt;/font&gt;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="c26"><mxGeometry x="20" y="326" width="550" height="170" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;4. Run&lt;/b&gt;&lt;br&gt;Prints the run line, then becomes the shortcut with &lt;font face=&quot;monospace&quot;&gt;exec&lt;/font&gt;. Your terminal, stdin, stdout and stderr go straight to it.&lt;br&gt;On Windows it runs as a child process with the same ones." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="c26"><mxGeometry x="20" y="516" width="550" height="140" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;5. Exit&lt;/b&gt;&lt;br&gt;The exit code and signals are the shortcut's own. Nothing sits in between.&lt;br&gt;Scripts also get &lt;font face=&quot;monospace&quot;&gt;SHORTCUT_NAME&lt;/font&gt; and &lt;font face=&quot;monospace&quot;&gt;SHORTCUT_CALLER_CWD&lt;/font&gt;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="c26"><mxGeometry x="20" y="676" width="550" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Working with it"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;How to work with shortcut&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1340" height="36" as="geometry"/></mxCell><mxCell id="c3" value="The store sets where a shortcut is visible. The cwd field sets where it runs." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1340" height="26" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Where it runs: the cwd field&lt;/b&gt;" style="text;html=1;align=left;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="640" height="28" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;strokeColor=#999999;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="640" height="171" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c5"><mxGeometry x="0" y="0" width="640" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;cwd&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="0" y="0" width="230" height="30" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Runs in&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="230" y="0" width="210" height="30" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Use it for&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="440" y="0" width="200" height="30" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c5"><mxGeometry x="0" y="30" width="640" height="47" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font face=&quot;monospace&quot;&gt;&quot;caller&quot;&lt;/font&gt; (the default)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c10"><mxGeometry x="0" y="0" width="230" height="47" as="geometry"/></mxCell><mxCell id="c12" value="Your current directory" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c10"><mxGeometry x="230" y="0" width="210" height="47" as="geometry"/></mxCell><mxCell id="c13" value="General tools used anywhere" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c10"><mxGeometry x="440" y="0" width="200" height="47" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c5"><mxGeometry x="0" y="77" width="640" height="47" as="geometry"/></mxCell><mxCell id="c15" value="&lt;font face=&quot;monospace&quot;&gt;&quot;.&quot;&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;&quot;../frontend&quot;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c14"><mxGeometry x="0" y="0" width="230" height="47" as="geometry"/></mxCell><mxCell id="c16" value="Relative to the file that defines it" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c14"><mxGeometry x="230" y="0" width="210" height="47" as="geometry"/></mxCell><mxCell id="c17" value="Commands that belong to a project" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c14"><mxGeometry x="440" y="0" width="200" height="47" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c5"><mxGeometry x="0" y="124" width="640" height="47" as="geometry"/></mxCell><mxCell id="c19" value="&lt;font face=&quot;monospace&quot;&gt;&quot;/var/www&quot;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="0" y="0" width="230" height="47" as="geometry"/></mxCell><mxCell id="c20" value="That fixed directory" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="230" y="0" width="210" height="47" as="geometry"/></mxCell><mxCell id="c21" value="One job that always runs there" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="440" y="0" width="200" height="47" as="geometry"/></mxCell><mxCell id="c22" value="Any word can be a name, even &lt;font face=&quot;monospace&quot;&gt;new&lt;/font&gt;: names appear only after &lt;font face=&quot;monospace&quot;&gt;run&lt;/font&gt;. A namespace and a shortcut can&#x27;t share a name in one store." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="311" width="640" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Install&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;With uv: &lt;font face=&quot;monospace&quot;&gt;uv tool install git+https://github.com/StanLukuvka/Shortcut&lt;/font&gt;&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Or with pipx: &lt;font face=&quot;monospace&quot;&gt;pipx install git+https://github.com/StanLukuvka/Shortcut&lt;/font&gt;&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Or from a clone: &lt;font face=&quot;monospace&quot;&gt;./install.sh&lt;/font&gt;, which also sets up completion.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Bundled shortcuts: &lt;font face=&quot;monospace&quot;&gt;shortcut init --global templates&lt;/font&gt; from a clone.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="660" height="150" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style='font-size:14px'&gt;Project shortcuts&lt;/b&gt;&lt;ol style='margin:8px 0 0 0;padding-left:22px'&gt;&lt;li style='margin-bottom:5px'&gt;Write &lt;font face=&quot;monospace&quot;&gt;.shortcuts&lt;/font&gt; by hand in the project root, and commit it. &lt;font face=&quot;monospace&quot;&gt;shortcut&lt;/font&gt; never writes it.&lt;/li&gt;&lt;li style='margin-bottom:5px'&gt;Anyone who clones it runs &lt;font face=&quot;monospace&quot;&gt;shortcut update&lt;/font&gt;, reads the diff and approves it.&lt;/li&gt;&lt;li style='margin-bottom:5px'&gt;&lt;font face=&quot;monospace&quot;&gt;--local&lt;/font&gt; writes to &lt;font face=&quot;monospace&quot;&gt;.shortcuts.local&lt;/font&gt;, which is yours and stays out of git. It adds, replaces or hides entries by name.&lt;/li&gt;&lt;li style='margin-bottom:5px'&gt;A change to either file, or a script they name, refuses to run until approved again. A change &lt;font face=&quot;monospace&quot;&gt;--local&lt;/font&gt; makes keeps its approval.&lt;/li&gt;&lt;li style='margin-bottom:5px'&gt;Move an entry to the shared file by hand: copy the entry field of &lt;font face=&quot;monospace&quot;&gt;shortcut show --json &amp;lt;name&amp;gt;&lt;/font&gt;.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="720" y="270" width="660" height="175" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Security model&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;shortcut runs exactly what its definitions say, without inspecting them.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;A project&#x27;s or import&#x27;s shortcuts don&#x27;t run until you approve them with &lt;font face=&quot;monospace&quot;&gt;shortcut update&lt;/font&gt;, and must be re-approved after any change to their definitions.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Approval covers definitions and the scripts they name, not the programs those call.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Global shortcuts have no approval step, so a global link target can change freely. &lt;font face=&quot;monospace&quot;&gt;init --global&lt;/font&gt; shows a collection before copying it.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Anyone who can write to your shortcut store can already run code as you; that&#x27;s out of scope.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="720" y="465" width="660" height="210" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Letting an agent set one up&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Always pass &lt;font face=&quot;monospace&quot;&gt;--desc&lt;/font&gt;.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Default for general tools, &lt;font face=&quot;monospace&quot;&gt;--local&lt;/font&gt; for a project, &lt;font face=&quot;monospace&quot;&gt;--cwd DIR&lt;/font&gt; for a fixed directory.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Tell the user: run it with &lt;font face=&quot;monospace&quot;&gt;shortcut r &amp;lt;name&amp;gt;&lt;/font&gt;.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;When it fails: &lt;font face=&quot;monospace&quot;&gt;shortcut show &amp;lt;name&amp;gt;&lt;/font&gt; prints the entry, run directory and script. &lt;font face=&quot;monospace&quot;&gt;shortcut list&lt;/font&gt; reports a broken file, an invalid entry or a missing script.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="363" width="640" height="150" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Declaring arguments&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;&lt;font face=&quot;monospace&quot;&gt;--arg name&lt;/font&gt; is required, &lt;font face=&quot;monospace&quot;&gt;--arg name=default&lt;/font&gt; is optional.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Arrive as &lt;font face=&quot;monospace&quot;&gt;$1&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;$2&lt;/font&gt;... and as &lt;font face=&quot;monospace&quot;&gt;SC_ARG_NAME&lt;/font&gt;.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Only presence and count are checked. &lt;font face=&quot;monospace&quot;&gt;--flags&lt;/font&gt; reach the script untouched.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;With no &lt;font face=&quot;monospace&quot;&gt;args&lt;/font&gt; key, nothing is checked.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;After &lt;font face=&quot;monospace&quot;&gt;--&lt;/font&gt;, a value can start with &lt;font face=&quot;monospace&quot;&gt;-&lt;/font&gt;.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="533" width="640" height="150" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Working on the code&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Edit &lt;font face=&quot;monospace&quot;&gt;shortcut.py&lt;/font&gt;. It is one file, standard library only, Python 3.10+.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Run the tests: &lt;font face=&quot;monospace&quot;&gt;python3 -m unittest discover -s tests -v&lt;/font&gt;. They never touch your real &lt;font face=&quot;monospace&quot;&gt;~/.shortcuts&lt;/font&gt;.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Install your change with &lt;font face=&quot;monospace&quot;&gt;./install.sh&lt;/font&gt;.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="703" width="640" height="160" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Environment variables&lt;/b&gt;" style="text;html=1;align=left;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="720" y="690" width="640" height="28" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;strokeColor=#999999;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="722" width="660" height="227" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c30"><mxGeometry x="0" y="0" width="660" height="30" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Variable&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="0" y="0" width="190" height="30" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Default&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="190" y="0" width="180" height="30" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Meaning&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="370" y="0" width="290" height="30" as="geometry"/></mxCell><mxCell id="c35" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c30"><mxGeometry x="0" y="30" width="660" height="30" as="geometry"/></mxCell><mxCell id="c36" value="&lt;font face=&quot;monospace&quot;&gt;SHORTCUTS_HOME&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c35"><mxGeometry x="0" y="0" width="190" height="30" as="geometry"/></mxCell><mxCell id="c37" value="&lt;font face=&quot;monospace&quot;&gt;~/.shortcuts&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c35"><mxGeometry x="190" y="0" width="180" height="30" as="geometry"/></mxCell><mxCell id="c38" value="Where the global store lives" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c35"><mxGeometry x="370" y="0" width="290" height="30" as="geometry"/></mxCell><mxCell id="c39" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c30"><mxGeometry x="0" y="60" width="660" height="47" as="geometry"/></mxCell><mxCell id="c40" value="&lt;font face=&quot;monospace&quot;&gt;SHORTCUT_SHOW_DIR&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c39"><mxGeometry x="0" y="0" width="190" height="47" as="geometry"/></mxCell><mxCell id="c41" value="&lt;font face=&quot;monospace&quot;&gt;1&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c39"><mxGeometry x="190" y="0" width="180" height="47" as="geometry"/></mxCell><mxCell id="c42" value="Set to &lt;font face=&quot;monospace&quot;&gt;0&lt;/font&gt; to hide the run line" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c39"><mxGeometry x="370" y="0" width="290" height="47" as="geometry"/></mxCell><mxCell id="c43" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c30"><mxGeometry x="0" y="107" width="660" height="30" as="geometry"/></mxCell><mxCell id="c44" value="&lt;font face=&quot;monospace&quot;&gt;VISUAL&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;EDITOR&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c43"><mxGeometry x="0" y="0" width="190" height="30" as="geometry"/></mxCell><mxCell id="c45" value="nano" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c43"><mxGeometry x="190" y="0" width="180" height="30" as="geometry"/></mxCell><mxCell id="c46" value="Editor for &lt;font face=&quot;monospace&quot;&gt;new&lt;/font&gt; and the bundled &lt;font face=&quot;monospace&quot;&gt;edit&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c43"><mxGeometry x="370" y="0" width="290" height="30" as="geometry"/></mxCell><mxCell id="c47" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c30"><mxGeometry x="0" y="137" width="660" height="30" as="geometry"/></mxCell><mxCell id="c48" value="&lt;font face=&quot;monospace&quot;&gt;PAGER&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c47"><mxGeometry x="0" y="0" width="190" height="30" as="geometry"/></mxCell><mxCell id="c49" value="none" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c47"><mxGeometry x="190" y="0" width="180" height="30" as="geometry"/></mxCell><mxCell id="c50" value="Pages long &lt;font face=&quot;monospace&quot;&gt;update&lt;/font&gt; diffs" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c47"><mxGeometry x="370" y="0" width="290" height="30" as="geometry"/></mxCell><mxCell id="c51" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c30"><mxGeometry x="0" y="167" width="660" height="30" as="geometry"/></mxCell><mxCell id="c52" value="&lt;font face=&quot;monospace&quot;&gt;BIN_DIR&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c51"><mxGeometry x="0" y="0" width="190" height="30" as="geometry"/></mxCell><mxCell id="c53" value="&lt;font face=&quot;monospace&quot;&gt;~/.local/bin&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c51"><mxGeometry x="190" y="0" width="180" height="30" as="geometry"/></mxCell><mxCell id="c54" value="Where &lt;font face=&quot;monospace&quot;&gt;install.sh&lt;/font&gt; puts the command" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c51"><mxGeometry x="370" y="0" width="290" height="30" as="geometry"/></mxCell><mxCell id="c55" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c30"><mxGeometry x="0" y="197" width="660" height="30" as="geometry"/></mxCell><mxCell id="c56" value="&lt;font face=&quot;monospace&quot;&gt;XDG_DATA_HOME&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="0" y="0" width="190" height="30" as="geometry"/></mxCell><mxCell id="c57" value="&lt;font face=&quot;monospace&quot;&gt;~/.local/share&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="190" y="0" width="180" height="30" as="geometry"/></mxCell><mxCell id="c58" value="Desktop launchers and completion" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c55"><mxGeometry x="370" y="0" width="290" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Commands"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="996" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Command reference&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1340" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Every command starts with shortcut. A name on its own is an error. FLAGS: --desc D, --cwd caller|DIR, --arg NAME[=DEFAULT], --confirm, --local, --namespace NAME, --by C. &amp;lt;name&amp;gt; can be a namespace and a name." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1340" height="26" as="geometry"/></mxCell><mxCell id="c4" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;strokeColor=#999999;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1340" height="30" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c4"><mxGeometry x="0" y="0" width="1340" height="30" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Command&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c5"><mxGeometry x="0" y="0" width="450" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;What it does&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c5"><mxGeometry x="450" y="0" width="480" height="30" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Example&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c5"><mxGeometry x="930" y="0" width="410" height="30" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;&lt;b&gt;Run&lt;/b&gt;&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#999999;fillColor=#e6e6e6;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1340" height="28" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;strokeColor=#999999;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="158" width="1340" height="47" as="geometry"/></mxCell><mxCell id="c11" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c10"><mxGeometry x="0" y="0" width="1340" height="47" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font face=&quot;monospace&quot;&gt;run [--global] [-y] &amp;lt;name&amp;gt; [args...]&lt;/font&gt;, or &lt;font face=&quot;monospace&quot;&gt;r&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c11"><mxGeometry x="0" y="0" width="450" height="47" as="geometry"/></mxCell><mxCell id="c13" value="Run a shortcut and pass the arguments through. --global skips the project, -y answers a confirm prompt. After --, a declared argument can start with -" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c11"><mxGeometry x="450" y="0" width="480" height="47" as="geometry"/></mxCell><mxCell id="c14" value="&lt;font face=&quot;monospace&quot;&gt;shortcut r docker delete XYZ&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c11"><mxGeometry x="930" y="0" width="410" height="47" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;&lt;b&gt;Create (global store unless --local)&lt;/b&gt;&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;strokeColor=#999999;fillColor=#e6e6e6;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="1340" height="28" as="geometry"/></mxCell><mxCell id="c16" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;strokeColor=#999999;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="233" width="1340" height="124" as="geometry"/></mxCell><mxCell id="c17" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c16"><mxGeometry x="0" y="0" width="1340" height="47" as="geometry"/></mxCell><mxCell id="c18" value="&lt;font face=&quot;monospace&quot;&gt;new &amp;lt;name&amp;gt; [FLAGS] [-- CMD...]&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c17"><mxGeometry x="0" y="0" width="450" height="47" as="geometry"/></mxCell><mxCell id="c19" value="With -- CMD: an inline shortcut. Without it: a script from a template, opened in your editor. No terminal: prints its path" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c17"><mxGeometry x="450" y="0" width="480" height="47" as="geometry"/></mxCell><mxCell id="c20" value="&lt;font face=&quot;monospace&quot;&gt;shortcut new hi --arg who -- &#x27;echo &quot;hi $1&quot;&#x27;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c17"><mxGeometry x="930" y="0" width="410" height="47" as="geometry"/></mxCell><mxCell id="c21" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c16"><mxGeometry x="0" y="47" width="1340" height="47" as="geometry"/></mxCell><mxCell id="c22" value="&lt;font face=&quot;monospace&quot;&gt;new &amp;lt;name&amp;gt; --copy FILE|- [FLAGS]&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c21"><mxGeometry x="0" y="0" width="450" height="47" as="geometry"/></mxCell><mxCell id="c23" value="Copy a script, or stdin, into the store" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c21"><mxGeometry x="450" y="0" width="480" height="47" as="geometry"/></mxCell><mxCell id="c24" value="&lt;font face=&quot;monospace&quot;&gt;shortcut new deploy --copy ./deploy.sh --cwd /var/www&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c21"><mxGeometry x="930" y="0" width="410" height="47" as="geometry"/></mxCell><mxCell id="c25" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c16"><mxGeometry x="0" y="94" width="1340" height="30" as="geometry"/></mxCell><mxCell id="c26" value="&lt;font face=&quot;monospace&quot;&gt;new &amp;lt;name&amp;gt; --script PATH [FLAGS]&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c25"><mxGeometry x="0" y="0" width="450" height="30" as="geometry"/></mxCell><mxCell id="c27" value="Point at a script where it is, without copying it" style="shape=partialRectangle;html=1;wh