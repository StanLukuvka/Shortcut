<mxfile host="app.diagrams.net"><diagram name="1 Structure"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="860" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;shortcut: project structure&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1360" height="36" as="geometry"/></mxCell><mxCell id="c3" value="What lives in the repository, what gets installed, and where shortcuts are stored." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1360" height="26" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;This repository&lt;/b&gt;" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=none;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="330" height="718" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;cmd/shortcut/, go.mod&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The main package and the Go module, no dependencies" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="44" width="300" height="58" as="geometry"/></mxCell><mxCell id="c5b" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;internal/commands/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The command table, and one package per command" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="176" width="300" height="58" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;installer/install.sh&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The curl installer: checks the release, installs the binary and completion" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="110" width="300" height="58" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;internal/store/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Store files, groups and lookup; approval/ and write/ below it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="242" width="300" height="58" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;internal/testkit/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Tests run with go test ./..., each in its own sandbox" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="374" width="300" height="58" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;internal/term/, internal/platform/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Terminal text, prompts and argparse/; file, process and JSON behaviour" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="308" width="300" height="58" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;README.md, AGENT.md&lt;/font&gt;&lt;/b&gt;&lt;br&gt;User docs and agent guide" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="506" width="300" height="58" as="geometry"/></mxCell><mxCell id="c9b" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;examples/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Namespaces to copy from: tools and podman" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="440" width="300" height="58" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;.github/workflows/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;CI: Go tests on Linux and macOS. A tag builds 4 archives and publishes them" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="572" width="300" height="58" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;docs/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Diagrams, icon, schema and the error table" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c4"><mxGeometry x="15" y="638" width="300" height="58" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Installed on your computer&lt;/b&gt;" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=none;collapsible=0;" vertex="1" parent="1"><mxGeometry x="500" y="100" width="330" height="266" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;~/.local/share/bash-completion/...&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Tab completion (fish too, if installed)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c13"><mxGeometry x="15" y="44" width="300" height="62" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;~/.local/bin/shortcut&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The command you type: one Go binary, from the GitHub release" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c13"><mxGeometry x="15" y="118" width="300" height="122" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;A project: &amp;lt;project&amp;gt;/&lt;/b&gt;" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=none;collapsible=0;" vertex="1" parent="1"><mxGeometry x="960" y="100" width="420" height="280" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;.shortcuts&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Shared and committed, edited by hand" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c17"><mxGeometry x="15" y="44" width="390" height="56" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;.shortcuts.local&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Personal, laid over .shortcuts, kept out of git" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c17"><mxGeometry x="15" y="108" width="390" height="56" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;&amp;lt;namespace&amp;gt;.shortcut&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Anywhere, listed under &quot;imports&quot;, run as shortcut r docker delete" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c17"><mxGeometry x="15" y="172" width="390" height="42" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;any script it names, e.g. tools/test.sh&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Relative paths start at the project root" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c17"><mxGeometry x="15" y="222" width="390" height="50" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Global store: ~/.shortcuts&lt;/b&gt;" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=none;collapsible=0;" vertex="1" parent="1"><mxGeometry x="960" y="460" width="420" height="380" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;shortcuts.json&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Your entries" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c22"><mxGeometry x="15" y="44" width="390" height="56" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;imports/&amp;lt;namespace&amp;gt;.shortcut&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Namespaces, approved like a project&#x27;s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c22"><mxGeometry x="15" y="108" width="390" height="56" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;approvals/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Per group: a SHA-256 of each file approved" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c22"><mxGeometry x="15" y="172" width="390" height="56" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;scripts/&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Scripts you keep here; entries point at them" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c22"><mxGeometry x="15" y="236" width="390" height="56" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;&lt;font face=&quot;monospace&quot;&gt;.lock&lt;/font&gt;&lt;/b&gt;&lt;br&gt;The one lock file: every write takes it" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=8;spacingRight=6;" vertex="1" parent="c22"><mxGeometry x="15" y="300" width="390" height="56" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Reading the arrows&lt;/b&gt;&lt;br&gt;Solid: a file is copied, or read and written.&lt;br&gt;Dashed: checked against, not changed.&lt;br&gt;&lt;br&gt;&lt;b&gt;Two places&lt;/b&gt;&lt;br&gt;Global store: visible everywhere.&lt;br&gt;Project: visible only inside it.&lt;br&gt;Projects and namespaces run only after &lt;font face=&quot;monospace&quot;&gt;shortcut update&lt;/font&gt; approves them." style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1"><mxGeometry x="500" y="436" width="330" height="190" as="geometry"/></mxCell><mxCell id="c29" value="installs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" source="c6" target="c15" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="reads in place" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.554;entryDx=0;entryDy=0;" edge="1" source="c15" target="c17" parent="1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="reads, writes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" source="c15" target="c22" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="322"/><mxPoint x="895" y="420"/><mxPoint x="1170" y="420"/></Array></mxGeometry></mxCell><mxCell id="c34" value="hash of" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="c25" target="c18" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1405" y="660"/><mxPoint x="1405" y="172"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2 How a name runs"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="960" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;What happens when you type shortcut r &amp;lt;name&amp;gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1340" height="36" as="geometry"/></mxCell><mxCell id="c3" value="Searched nearest first: project, then global store. --global skips the project. Each gate has to pass before anything runs." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1340" height="26" as="geometry"/></mxCell><mxCell id="c4" value="&lt;font face=&quot;monospace&quot;&gt;shortcut r [--global] [-y] &amp;lt;name&amp;gt; [args]&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="50" y="105" width="320" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Found in the project, or as a namespace there?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="190" width="220" height="100" as="geometry"/></mxCell><mxCell id="c6" value="Found in the global store, or as a namespace there?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="325" width="220" height="100" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Error&lt;/b&gt;: not found" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="435" y="345" width="190" height="60" as="geometry"/></mxCell><mxCell id="c8" value="Group approved and unchanged?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="460" width="220" height="100" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Refused&lt;/b&gt;, only this group:&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;docker changed since you approved it; run: shortcut update docker&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="465" width="280" height="90" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font face=&quot;monospace&quot;&gt;confirm&lt;/font&gt; set? Then &lt;font face=&quot;monospace&quot;&gt;-y&lt;/font&gt; or a yes" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="595" width="220" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Refused&lt;/b&gt;: answered no, or no terminal and no -y" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="605" width="280" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Run it&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="720" width="180" height="50" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c4" target="c5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c5" target="c6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c6" target="c8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c18" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c8" target="c12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c12" target="c14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c6" target="c7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c8" target="c9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;" edge="1" source="c12" target="c13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;defaultLabelBackgroundColor=page;fontSize=11;endArrow=classic;strokeColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" source="c5" target="c8" parent="1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="240"/><mxPoint x="70" y="510"/></Array></mxGeometry></mxCell><mxCell id="c26" value="&lt;b&gt;Then every shortcut runs the same way&lt;/b&gt;" style="swimlane;startSize=30;html=1;rounded=1;arcSize=2;fontSize=14;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=none;collapsible=0;" vertex="1" parent="1"><mxGeometry x="790" y="105" width="590" height="760" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;1. Work out the directory&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;monospace&quot;&gt;cwd&lt;/font&gt; is &lt;font face=&quot;monospace&quot;&gt;caller&lt;/font&gt; (the default): your current directory.&lt;br&gt;A relative path: from the folder of the file that defines it, so &lt;font face=&quot;monospace&quot;&gt;.&lt;/font&gt; is a project's root.&lt;br&gt;An absolute path: that directory." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="c26"><mxGeometry x="20" y="46" width="550" height="140" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;2. Show it&lt;/b&gt;&lt;br&gt;Prints &lt;font face=&quot;monospace&quot;&gt;→ /the/run/dir&lt;/font&gt; in dim text on stderr. &lt;font face=&quot;monospace&quot;&gt;SHORTCUT_SHOW_DIR=0&lt;/font&gt; hides it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="c26"><mxGeometry x="20" y="206" width="550" height="100" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;3. Build the command&lt;/b&gt;&lt;br&gt;Inline: &lt;font face=&quot;monospace&quot;&gt;bash -c&lt;/font&gt; with your arguments as &lt;font face=&quot;monospace&quot;&gt;$1&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;$2&lt;/font&gt;...&lt;br&gt;Script: runs as it is, so it needs +x and a &lt;font face=&quot;monospace&quot;&gt;#!&lt;/font&gt; line, or is a binary.&lt;br&gt;Not executable: refused, with the &lt;font face=&quot;monospace&quot;&gt;chmod +x&lt;/font&gt; command to fix it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="c26"><mxGeometry x="20" y="326" width="550" height="150" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;4. Run&lt;/b&gt;&lt;br&gt;Prints the run line, then becomes the shortcut with &lt;font face=&quot;monospace&quot;&gt;exec&lt;/font&gt;. Your terminal, stdin, stdout and stderr go straight to it." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="c26"><mxGeometry x="20" y="496" width="550" height="120" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;5. Exit&lt;/b&gt;&lt;br&gt;The exit code and signals are the shortcut&#x27;s own. Nothing sits in between.&lt;br&gt;Every shortcut also gets &lt;font face=&quot;monospace&quot;&gt;SHORTCUT_NAME&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;SHORTCUT_NAMESPACE&lt;/font&gt; and &lt;font face=&quot;monospace&quot;&gt;SHORTCUT_CALLER_CWD&lt;/font&gt;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=middle;spacing=10;" vertex="1" parent="c26"><mxGeometry x="20" y="636" width="550" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Working with it"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;How to work with shortcut&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1340" height="36" as="geometry"/></mxCell><mxCell id="c3" value="The store sets where a shortcut is visible. The cwd field sets where it runs." style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#666666;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="56" width="1340" height="26" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Where it runs: the cwd field&lt;/b&gt;" style="text;html=1;align=left;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="640" height="28" as="geometry"/></mxCell><mxCell id="c5" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;strokeColor=#999999;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="132" width="640" height="171" as="geometry"/></mxCell><mxCell id="c6" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c5"><mxGeometry x="0" y="0" width="640" height="30" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;cwd&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="0" y="0" width="230" height="30" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Runs in&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="230" y="0" width="210" height="30" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Use it for&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c6"><mxGeometry x="440" y="0" width="200" height="30" as="geometry"/></mxCell><mxCell id="c10" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c5"><mxGeometry x="0" y="30" width="640" height="47" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font face=&quot;monospace&quot;&gt;&quot;caller&quot;&lt;/font&gt; (the default)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c10"><mxGeometry x="0" y="0" width="230" height="47" as="geometry"/></mxCell><mxCell id="c12" value="Your current directory" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c10"><mxGeometry x="230" y="0" width="210" height="47" as="geometry"/></mxCell><mxCell id="c13" value="General tools used anywhere" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c10"><mxGeometry x="440" y="0" width="200" height="47" as="geometry"/></mxCell><mxCell id="c14" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c5"><mxGeometry x="0" y="77" width="640" height="47" as="geometry"/></mxCell><mxCell id="c15" value="&lt;font face=&quot;monospace&quot;&gt;&quot;.&quot;&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;&quot;../frontend&quot;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c14"><mxGeometry x="0" y="0" width="230" height="47" as="geometry"/></mxCell><mxCell id="c16" value="Relative to the file that defines it" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c14"><mxGeometry x="230" y="0" width="210" height="47" as="geometry"/></mxCell><mxCell id="c17" value="Commands that belong to a project" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c14"><mxGeometry x="440" y="0" width="200" height="47" as="geometry"/></mxCell><mxCell id="c18" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c5"><mxGeometry x="0" y="124" width="640" height="47" as="geometry"/></mxCell><mxCell id="c19" value="&lt;font face=&quot;monospace&quot;&gt;&quot;/var/www&quot;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="0" y="0" width="230" height="47" as="geometry"/></mxCell><mxCell id="c20" value="That fixed directory" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="230" y="0" width="210" height="47" as="geometry"/></mxCell><mxCell id="c21" value="One job that always runs there" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c18"><mxGeometry x="440" y="0" width="200" height="47" as="geometry"/></mxCell><mxCell id="c22" value="Any word can be a name, even &lt;font face=&quot;monospace&quot;&gt;new&lt;/font&gt;: names appear only after &lt;font face=&quot;monospace&quot;&gt;run&lt;/font&gt;. A namespace and a shortcut can&#x27;t share a name in one store." style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="311" width="640" height="44" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Install&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Run &lt;font face=&quot;monospace&quot;&gt;curl -fsSL https://github.com/StanLukuvka/Shortcut/releases/latest/download/install.sh | sh&lt;/font&gt;&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;It checks the download against checksums.txt, puts the binary in &lt;font face=&quot;monospace&quot;&gt;~/.local/bin&lt;/font&gt; and sets up completion.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Pin a version with &lt;font face=&quot;monospace&quot;&gt;SHORTCUT_VERSION=0.1.0&lt;/font&gt;. To upgrade, run it again.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="720" y="100" width="660" height="125" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Project shortcuts&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Write &lt;font face=&quot;monospace&quot;&gt;.shortcuts&lt;/font&gt; by hand in the project root, and commit it. &lt;font face=&quot;monospace&quot;&gt;shortcut&lt;/font&gt; never writes it.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Anyone who clones it runs &lt;font face=&quot;monospace&quot;&gt;shortcut update&lt;/font&gt;, reads what changed and approves it.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;&lt;font face=&quot;monospace&quot;&gt;--local&lt;/font&gt; writes to &lt;font face=&quot;monospace&quot;&gt;.shortcuts.local&lt;/font&gt;, which is yours and stays out of git. It adds, replaces or hides entries by name.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;A change to either file, or a script they name, refuses to run until approved again. A change &lt;font face=&quot;monospace&quot;&gt;--local&lt;/font&gt; makes keeps its approval.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Move an entry to the shared file by hand: copy the entry field of &lt;font face=&quot;monospace&quot;&gt;shortcut show --json &amp;lt;name&amp;gt;&lt;/font&gt;.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="720" y="245" width="660" height="175" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Security model&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;shortcut runs exactly what its definitions say, without inspecting them.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;A project&#x27;s or import&#x27;s shortcuts don&#x27;t run until you approve them with &lt;font face=&quot;monospace&quot;&gt;shortcut update&lt;/font&gt;, and must be re-approved after any change to their definitions.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Approval covers definitions and the scripts they name, not the programs those call.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Global shortcuts have no approval step, so a global link target can change freely.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Anyone who can write to your shortcut store can already run code as you; that&#x27;s out of scope.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="720" y="440" width="660" height="190" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Letting an agent set one up&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Always pass &lt;font face=&quot;monospace&quot;&gt;--desc&lt;/font&gt;.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Default for general tools, &lt;font face=&quot;monospace&quot;&gt;--local&lt;/font&gt; for a project, &lt;font face=&quot;monospace&quot;&gt;--cwd DIR&lt;/font&gt; for a fixed directory.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Tell the user: run it with &lt;font face=&quot;monospace&quot;&gt;shortcut r &amp;lt;name&amp;gt;&lt;/font&gt;.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;When it fails: &lt;font face=&quot;monospace&quot;&gt;shortcut show &amp;lt;name&amp;gt;&lt;/font&gt; prints the entry, run directory and script. &lt;font face=&quot;monospace&quot;&gt;shortcut list&lt;/font&gt; reports a broken file, an invalid entry or a missing script.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="363" width="640" height="150" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Arguments&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Every word after the name reaches the shortcut as &lt;font face=&quot;monospace&quot;&gt;$1&lt;/font&gt;, &lt;font face=&quot;monospace&quot;&gt;$2&lt;/font&gt;..., flags included.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Nothing is checked or declared: the shortcut reads what it needs.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;A first &lt;font face=&quot;monospace&quot;&gt;--&lt;/font&gt; is passed on as it is.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="533" width="640" height="110" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b style=&#x27;font-size:14px&#x27;&gt;Working on the code&lt;/b&gt;&lt;ol style=&#x27;margin:8px 0 0 0;padding-left:22px&#x27;&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Edit &lt;font face=&quot;monospace&quot;&gt;internal/commands/&lt;/font&gt;: a package per command. Go, standard library only.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Run the tests: &lt;font face=&quot;monospace&quot;&gt;go test ./...&lt;/font&gt;. They run in a sandbox and never touch your real &lt;font face=&quot;monospace&quot;&gt;~/.shortcuts&lt;/font&gt;.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Build your change with &lt;font face=&quot;monospace&quot;&gt;go build -o bin/shortcut ./cmd/shortcut&lt;/font&gt;.&lt;/li&gt;&lt;li style=&#x27;margin-bottom:5px&#x27;&gt;Release: tag &lt;font face=&quot;monospace&quot;&gt;v&amp;lt;version&amp;gt;&lt;/font&gt;. The workflow builds 4 archives and publishes them.&lt;/li&gt;&lt;/ol&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="663" width="640" height="130" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Environment variables&lt;/b&gt;" style="text;html=1;align=left;fontSize=16;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="720" y="650" width="640" height="28" as="geometry"/></mxCell><mxCell id="c30" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;strokeColor=#999999;fontSize=12;html=1;" vertex="1" parent="1"><mxGeometry x="720" y="682" width="660" height="197" as="geometry"/></mxCell><mxCell id="c31" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c30"><mxGeometry x="0" y="0" width="660" height="30" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;Variable&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="0" y="0" width="190" height="30" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Default&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="190" y="0" width="180" height="30" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Meaning&lt;/b&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=#dae8fc;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" 