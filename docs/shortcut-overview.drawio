=12;" vertex="1" parent="c31"><mxGeometry x="0" y="0" width="450" height="30" as="geometry"/></mxCell><mxCell id="c33" value="Visible shortcuts and namespaces, with each one&#x27;s cwd and source" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="450" y="0" width="480" height="30" as="geometry"/></mxCell><mxCell id="c34" value="&lt;font face=&quot;monospace&quot;&gt;shortcut list&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c31"><mxGeometry x="930" y="0" width="410" height="30" as="geometry"/></mxCell><mxCell id="c35" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;" vertex="1" parent="c30"><mxGeometry x="0" y="30" width="1340" height="30" as="geometry"/></mxCell><mxCell id="c36" value="&lt;font face=&quot;monospace&quot;&gt;show [--global] [--json] &amp;lt;name&amp;gt;&lt;/font&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=12;" vertex="1" parent="c35"><mxGeometry x="0" y="0" width="450" height="30" as="geometry"/></mxCell><mxCell id="c37" value="Details and the full script or command. --json prints it all as JSON" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bott