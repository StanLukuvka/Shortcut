#!/usr/bin/env python3

from __future__ import annotations

import argparse
import dataclasses
from datetime import date, datetime, timezone
import json
import os
import pathlib
import re
import shlex
import shutil
import signal
import subprocess
import sys
import tempfile
from typing import Any, Dict, List, NoReturn, Optional, Set, Tuple

# Version and Constants
VERSION: str = "1.0.0"
RESERVED_PREFIXES: Set[str] = {"g_", "glob_", "global_"}
BUILTIN_COMMANDS: Set[str] = {
    "run", "new", "add", "link", "list", "show", "nano", "edit",
    "location", "rm", "log", "fix", "desktop", "prefix", "init",
    "migrate", "completion", "help", "--help", "-h", "version", "--version"
}


@dataclasses.dataclass(frozen=True)
class ShortcutEntry:
    name: str
    description: str
    inline: Optional[str] = None
    script: Optional[str] = None
    dir: Optional[str] = None
    icon: Optional[str] = None
    created_by: Optional[str] = None
    created: Optional[str] = None
    log: bool = True

    @classmethod
    def from_dict(cls, name: str, data: Dict[str, Any]) -> ShortcutEntry:
        return cls(
            name=name,
            description=data.get("description", ""),
            inline=data.get("inline"),
            script=data.get("script"),
            dir=data.get("dir"),
            icon=data.get("icon"),
            created_by=data.get("created_by"),
            created=data.get("created"),
            log=data.get("log", True),
        )

    def to_dict(self) -> Dict[str, Any]:
        d: Dict[str, Any] = {"description": self.description}
        if self.inline is not None:
            d["inline"] = self.inline
        if self.script is not None:
            d["script"] = self.script
        if self.dir is not None:
            d["dir"] = self.dir
        if self.icon is not None:
            d["icon"] = self.icon
        if self.created_by is not None:
            d["created_by"] = self.created_by
        if self.created is not None:
            d["created"] = self.created
        if not self.log:
            d["log"] = False
        return d


@dataclasses.dataclass(frozen=True)
class ResolvedShortcut:
    entry: ShortcutEntry
    store_dir: str
    scope: str            # 'global' | 'prefix' | 'static' | 'local'
    run_cwd: str          # computed execution directory


def die(msg: str, exit_code: int = 1) -> NoReturn:
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(exit_code)


def get_global_store_dir() -> str:
    env_dir = os.environ.get("SHORTCUTS_HOME")
    if env_dir:
        return os.path.abspath(os.path.expanduser(env_dir))
    return os.path.abspath(os.path.expanduser("~/.shortcuts"))


def registry_exists(store_dir: str) -> bool:
    return os.path.isfile(os.path.join(store_dir, "shortcuts.json"))


def find_local_store_dir(start_dir: Optional[str] = None) -> Optional[str]:
    curr = pathlib.Path(start_dir or os.getcwd()).resolve()
    global_root = pathlib.Path(get_global_store_dir()).resolve()
    for p in [curr, *curr.parents]:
        candidate = p / ".shortcuts"
        if candidate.resolve() == global_root:
            continue
        if (candidate / "shortcuts.json").is_file():
            return str(candidate)
    return None


def init_store(store_dir: str, is_global: bool = False) -> None:
    os.makedirs(store_dir, exist_ok=True)
    reg_path = os.path.join(store_dir, "shortcuts.json")
    if not os.path.isfile(reg_path):
        data: Dict[str, Any] = {"version": 1, "shortcuts": {}}
        if is_global:
            data["prefixes"] = {}
        save_registry_atomic(store_dir, data)


def load_registry(store_dir: str) -> Dict[str, Any]:
    reg_path = os.path.join(store_dir, "shortcuts.json")
    if not os.path.isfile(reg_path):
        raise FileNotFoundError(f"Registry not found: {reg_path}")
    try:
        with open(reg_path, "r", encoding="utf-8") as f:
            data = json.load(f)
    except json.JSONDecodeError as e:
        raise ValueError(f"Corrupt registry in {store_dir}: {e}") from e
    if not isinstance(data, dict):
        raise ValueError(f"Corrupt registry in {store_dir}: root must be a JSON object")
    return data


def save_registry_atomic(store_dir: str, registry_data: Dict[str, Any]) -> None:
    os.makedirs(store_dir, exist_ok=True)
    reg_path = os.path.join(store_dir, "shortcuts.json")
    if os.path.isfile(reg_path):
        try:
            with open(reg_path, "r", encoding="utf-8") as f:
                json.load(f)
        except Exception as e:
            raise ValueError(f"Cannot overwrite corrupt registry in {store_dir}: {e}") from e

    temp_file = tempfile.NamedTemporaryFile("w", dir=store_dir, delete=False, encoding="utf-8")
    try:
        json.dump(registry_data, temp_file, indent=2)
        temp_file.write("\n")
        temp_file.flush()
        os.fsync(temp_file.fileno())
        temp_file.close()
        os.replace(temp_file.name, reg_path)
    except Exception:
        if os.path.exists(temp_file.name):
            try:
                os.unlink(temp_file.name)
            except OSError:
                pass
        raise


def validate_name(name: str) -> None:
    if name in BUILTIN_COMMANDS:
        raise ValueError(f"'{name}' is a built-in command name and cannot be used as a shortcut name.")
    if not re.fullmatch(r"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$", name):
        raise ValueError(
            f"Invalid shortcut name '{name}'. Must match ^[A-Za-z0-9][A-Za-z0-9_-]{{0,63}}$ "
            "(alphanumeric start, up to 64 characters of letters, digits, underscores, and dashes)."
        )


def validate_prefix(prefix: str) -> None:
    if prefix in RESERVED_PREFIXES:
        raise ValueError(f"Prefix '{prefix}' is reserved and cannot be registered.")
    if not re.fullmatch(r"^[A-Za-z][A-Za-z0-9]*_$", prefix):
        raise ValueError(
            f"Invalid prefix '{prefix}'. Must match ^[A-Za-z][A-Za-z0-9]*_$ "
            "(letter start, alphanumeric, ending in underscore)."
        )


def resolve_script_path(store_dir: str, script_field: str) -> str:
    """
    Resolves a script path. Absolute paths are external links.
    Relative paths must be stored inside store_dir and cannot escape.
    """
    if os.path.isabs(script_field):
        return script_field

    base = pathlib.Path(store_dir).resolve()
    target = (base / script_field).resolve()

    if not target.is_relative_to(base):
        raise ValueError(
            f"Path traversal detected: script '{script_field}' resolves to '{target}', outside store '{base}'."
        )
    return str(target)


def resolve_shortcut(name: str, caller_cwd: Optional[str] = None) -> ResolvedShortcut:
    caller_cwd = caller_cwd or os.getcwd()
    global_dir = get_global_store_dir()
    global_reg = load_registry(global_dir) if registry_exists(global_dir) else {"shortcuts": {}}
    global_shortcuts = global_reg.get("shortcuts", {})
    global_prefixes: Dict[str, str] = global_reg.get("prefixes", {})

    # 1. Global prefix: 'g_', 'glob_', or 'global_'
    if any(name.startswith(p) for p in ("g_", "glob_", "global_")):
        if name not in global_shortcuts:
            raise KeyError(f"Shortcut '{name}' not found in global store.")
        entry = ShortcutEntry.from_dict(name, global_shortcuts[name])
        return ResolvedShortcut(entry=entry, store_dir=global_dir, scope="global", run_cwd=caller_cwd)

    # 2. Registered prefix matching: longest matching prefix wins
    matching_prefixes = [p for p in global_prefixes if name.startswith(p)]
    if matching_prefixes:
        matching_prefixes.sort(key=len, reverse=True)
        prefix = matching_prefixes[0]
        if name not in global_shortcuts:
            raise KeyError(f"Shortcut '{name}' with prefix '{prefix}' not found in global store.")
        entry = ShortcutEntry.from_dict(name, global_shortcuts[name])
        prefix_target_dir = global_prefixes[prefix]
        return ResolvedShortcut(entry=entry, store_dir=global_dir, scope="prefix", run_cwd=prefix_target_dir)

    # 3. Unprefixed: Local store first
    local_dir = find_local_store_dir(caller_cwd)
    if local_dir:
        local_reg = load_registry(local_dir)
        local_shortcuts = local_reg.get("shortcuts", {})
        if name in local_shortcuts:
            entry = ShortcutEntry.from_dict(name, local_shortcuts[name])
            project_root = os.path.dirname(local_dir)
            return ResolvedShortcut(entry=entry, store_dir=local_dir, scope="local", run_cwd=project_root)

    # 4. Unprefixed: Global static fallback
    if name in global_shortcuts:
        entry = ShortcutEntry.from_dict(name, global_shortcuts[name])
        if entry.dir:
            return ResolvedShortcut(entry=entry, store_dir=global_dir, scope="static", run_cwd=entry.dir)
        raise ValueError(f"Unprefixed shortcut '{name}' in global store missing required 'dir' property.")

    # 5. Not found: Check for potential hints
    for p in ("g_", "glob_", "global_"):
        hint_name = f"{p}{name}"
        if hint_name in global_shortcuts:
            raise KeyError(f"Shortcut '{name}' not found. Did you mean '{hint_name}'?")

    raise KeyError(f"Shortcut '{name}' not found.")


def run_shortcut(name: str, args: List[str], caller_cwd: Optional[str] = None) -> int:
    caller_cwd = caller_cwd or os.getcwd()
    resolved = resolve_shortcut(name, caller_cwd)
    entry = resolved.entry

    # Build command argv
    if entry.inline is not None:
        cmd = ["bash", "-c", entry.inline, name, *args]
    elif entry.script is not None:
        script_path = resolve_script_path(resolved.store_dir, entry.script)
        if not os.path.exists(script_path):
            raise FileNotFoundError(f"Script file not found: {script_path}")
        is_exec = os.access(script_path, os.X_OK)
        has_shebang = False
        try:
            with open(script_path, "rb") as f:
                has_shebang = f.read(2) == b"#!"
        except OSError:
            pass
        cmd = [script_path, *args] if (is_exec and has_shebang) else ["bash", script_path, *args]
    else:
        raise ValueError(f"Entry '{name}' has neither 'inline' nor 'script'.")

    env = os.environ.copy()
    env["SHORTCUT_NAME"] = name
    env["SHORTCUT_CALLER_CWD"] = caller_cwd

    if not entry.log:
        proc = subprocess.Popen(cmd, cwd=resolved.run_cwd, env=env)
        try:
            rc = proc.wait()
        except KeyboardInterrupt:
            if proc.poll() is None:
                try:
                    proc.send_signal(signal.SIGINT)
                except OSError:
                    pass
            try:
                rc = proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                rc = proc.wait()
            if rc >= 0:
                rc = 130
        if rc < 0:
            rc = 128 - rc
        return rc

    log_dir = os.path.join(resolved.store_dir, "logs")
    os.makedirs(log_dir, exist_ok=True)
    log_file = os.path.join(log_dir, f"{name}.log")

    now_iso = datetime.now(timezone.utc).isoformat()
    header = f"=== SHORTCUT RUN: {name} | {now_iso} | cwd: {resolved.run_cwd} | args: {shlex.join(args)} ===\n"

    with open(log_file, "wb") as lf:  # binary: no decode split across chunk boundaries
        lf.write(header.encode())
        proc = subprocess.Popen(
            cmd,
            cwd=resolved.run_cwd,
            env=env,
            stdin=None,  # inherit caller stdin for interactivity
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            bufsize=0,
        )
        assert proc.stdout is not None
        last = b"\n"
        try:
            while chunk := os.read(proc.stdout.fileno(), 4096):  # returns partial lines immediately
                sys.stdout.buffer.write(chunk)
                sys.stdout.buffer.flush()
                lf.write(chunk)
                lf.flush()
                last = chunk[-1:]
            rc = proc.wait()
        except KeyboardInterrupt:
            # Ctrl+C reaches the child too (same process group); let it finish, never leave it orphaned.
            if proc.poll() is None:
                try:
                    proc.send_signal(signal.SIGINT)
                except OSError:
                    pass
            try:
                rc = proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
                rc = proc.wait()
            if rc >= 0:
                rc = 130
        if rc < 0:  # killed by signal N -> shell convention 128+N
            rc = 128 - rc
        if last != b"\n":
            lf.write(b"\n")
        lf.write(f"=== exit: {rc} ===\n".encode())

    return rc


def choose_target_store(name: str, static_dir: Optional[str], local: bool, cwd: str) -> Tuple[str, Optional[str]]:
    """Return (store_dir, absolute static dir or None). Prints a notice when it creates ./.shortcuts/."""
    validate_name(name)  # grammar + not a BUILTIN_COMMANDS member
    global_dir = get_global_store_dir()
    prefixes = load_registry(global_dir).get("prefixes", {}) if registry_exists(global_dir) else {}
    is_global_named = name.startswith(("g_", "glob_", "global_"))
    has_reg_prefix = any(name.startswith(p) for p in prefixes)
    if is_global_named or has_reg_prefix:
        if static_dir or local:
            die(f"'{name}' is {'global' if is_global_named else 'prefix'}-named; --static/--local not allowed")
        return global_dir, None
    if static_dir and local:
        die("--static and --local are mutually exclusive")
    if static_dir:
        d = os.path.abspath(os.path.expanduser(static_dir))
        if not os.path.isdir(d):
            die(f"--static dir does not exist: {d}")
        return global_dir, d
    local_dir = find_local_store_dir(cwd)
    if local_dir is None:
        local_dir = os.path.join(cwd, ".shortcuts")
        init_store(local_dir)  # writes {"version":1,"shortcuts":{}}
        print(f"created local store {local_dir} (shortcut '{name}' is only visible under {cwd})", file=sys.stderr)
    return local_dir, None


def get_editor_cmd(fallback: str = "nano") -> List[str]:
    # lazy: simple env var inspection for editor; upgrade to full fallback chain with sensible GUI editors if needed
    if env_cmd := os.environ.get("SHORTCUT_EDITOR_CMD"):
        return shlex.split(env_cmd)
    editor = os.environ.get("VISUAL") or os.environ.get("EDITOR") or fallback
    return shlex.split(editor)


def edit_inline_roundtrip(name: str, store_dir: str, editor_cmd: List[str]) -> None:
    reg = load_registry(store_dir)
    shortcuts = reg.get("shortcuts", {})
    if name not in shortcuts or "inline" not in shortcuts[name]:
        raise ValueError(f"'{name}' is not an inline shortcut.")

    original_cmd = shortcuts[name]["inline"]
    with tempfile.NamedTemporaryFile("w+", suffix=f"-{name}.sh", delete=False, encoding="utf-8") as tf:
        temp_path = tf.name
        tf.write(original_cmd)
        if not original_cmd.endswith("\n"):
            tf.write("\n")
        tf.flush()

    try:
        res = subprocess.run([*editor_cmd, temp_path])
        if res.returncode != 0:
            raise RuntimeError(f"Editor exited with code {res.returncode}")
        with open(temp_path, "r", encoding="utf-8") as tf_read:
            updated_cmd = tf_read.read().rstrip("\r\n")

        # Save only if modified
        if updated_cmd != original_cmd.rstrip("\r\n"):
            shortcuts[name]["inline"] = updated_cmd
            save_registry_atomic(store_dir, reg)
            print(f"Updated inline shortcut '{name}'.")
        else:
            print(f"No changes made to '{name}'.")
    finally:
        if os.path.exists(temp_path):
            os.unlink(temp_path)


def cmd_run(args: List[str]) -> int:
    if not args:
        print("shortcut run: missing shortcut name\nUsage: shortcut run <name> [args...]", file=sys.stderr)
        return 2
    return run_shortcut(args[0], args[1:])


def cmd_new(args: List[str]) -> int:
    parser = argparse.ArgumentParser(prog="shortcut new", description="Create a new shortcut")
    parser.add_argument("name", help="Shortcut name")
    parser.add_argument("--desc", default=None, help="Shortcut description")
    parser.add_argument("--static", default=None, help="Static directory for global scope")
    parser.add_argument("--local", action="store_true", help="Store locally in nearest project")
    parser.add_argument("--by", default=None, help="Creator identifier")

    # Split args at '--' if present
    inline_cmd_tokens: Optional[List[str]] = None
    if "--" in args:
        dash_idx = args.index("--")
        pre_args = args[:dash_idx]
        inline_cmd_tokens = args[dash_idx + 1:]
    else:
        pre_args = args

    parsed = parser.parse_args(pre_args)
    cwd = os.getcwd()
    store_dir, static_target = choose_target_store(parsed.name, parsed.static, parsed.local, cwd)

    reg = load_registry(store_dir) if registry_exists(store_dir) else {"version": 1, "shortcuts": {}}
    shortcuts = reg.setdefault("shortcuts", {})
    if parsed.name in shortcuts:
        die(f"Shortcut '{parsed.name}' already exists in store {store_dir}")

    today = date.today().isoformat()

    if inline_cmd_tokens is not None:
        if not inline_cmd_tokens:
            die("Command expected after '--'")
        if len(inline_cmd_tokens) == 1:
            inline_str = inline_cmd_tokens[0]
        else:
            inline_str = shlex.join(inline_cmd_tokens)
        desc = parsed.desc if parsed.desc is not None else inline_str
        entry = ShortcutEntry(
            name=parsed.name,
            description=desc,
            inline=inline_str,
            dir=static_target,
            created_by=parsed.by,
            created=today,
        )
        shortcuts[parsed.name] = entry.to_dict()
        save_registry_atomic(store_dir, reg)
        print(f"Created inline shortcut '{parsed.name}'.")
        return 0
    else:
        scripts_dir = os.path.join(store_dir, "scripts")
        os.makedirs(scripts_dir, exist_ok=True)
        rel_script_path = f"scripts/{parsed.name}.sh"
        abs_script_path = os.path.join(store_dir, rel_script_path)

        # lazy: default shell template is bash-only; upgrade to template selection flag if multi-shell support needed
        template_content = "#!/usr/bin/env bash\nset -euo pipefail\n\n"
        with open(abs_script_path, "w", encoding="utf-8") as sf:
            sf.write(template_content)
        os.chmod(abs_script_path, 0o755)

        desc = parsed.desc if parsed.desc is not None else "(no description)"
        entry = ShortcutEntry(
            name=parsed.name,
            description=desc,
            script=rel_script_path,
            dir=static_target,
            created_by=parsed.by,
            created=today,
        )
        shortcuts[parsed.name] = entry.to_dict()
        save_registry_atomic(store_dir, reg)
        print(f"Created script shortcut '{parsed.name}'.")

        # SHORTCUT_EDITOR_CMD wins over nano; documented test hook
        editor_cmd = shlex.split(os.environ["SHORTCUT_EDITOR_CMD"]) if "SHORTCUT_EDITOR_CMD" in os.environ else ["nano"]
        res = subprocess.run([*editor_cmd, abs_script_path])
        return res.returncode


def cmd_add(args: List[str]) -> int:
    parser = argparse.ArgumentParser(prog="shortcut add", description="Add an existing script to shortcut store")
    parser.add_argument("name", help="Shortcut name")
    parser.add_argument("file", help="Path to script file, or '-' for stdin")
    parser.add_argument("--desc", required=True, help="Shortcut description")
    parser.add_argument("--static", default=None, help="Static directory for global scope")
    parser.add_argument("--local", action="store_true", help="Store locally in nearest project")
    parser.add_argument("--by", default=None, help="Creator identifier")

    parsed = parser.parse_args(args)
    cwd = os.getcwd()
    store_dir, static_target = choose_target_store(parsed.name, parsed.static, parsed.local, cwd)

    reg = load_registry(store_dir) if registry_exists(store_dir) else {"version": 1, "shortcuts": {}}
    shortcuts = reg.setdefault("shortcuts", {})
    if parsed.name in shortcuts:
        die(f"Shortcut '{parsed.name}' already exists in store {store_dir}")

    scripts_dir = os.path.join(store_dir, "scripts")
    os.makedirs(scripts_dir, exist_ok=True)

    if parsed.file == "-":
        ext = ".sh"
        rel_script_path = f"scripts/{parsed.name}{ext}"
        abs_script_path = os.path.join(store_dir, rel_script_path)
        content = sys.stdin.read()
        with open(abs_script_path, "w", encoding="utf-8") as f:
            f.write(content)
        os.chmod(abs_script_path, 0o755)
    else:
        src_path = os.path.abspath(os.path.expanduser(parsed.file))
        if not os.path.isfile(src_path):
            die(f"Source file not found: {src_path}")
        ext = pathlib.Path(src_path).suffix or ".sh"
        rel_script_path = f"scripts/{parsed.name}{ext}"
        abs_script_path = os.path.join(store_dir, rel_script_path)
        shutil.copy2(src_path, abs_script_path)
        os.chmod(abs_script_path, os.stat(abs_script_path).st_mode | 0o111)

    today = date.today().isoformat()
    entry = ShortcutEntry(
        name=parsed.name,
        description=parsed.desc,
        script=rel_script_path,
        dir=static_target,
        created_by=parsed.by,
        created=today,
    )
    shortcuts[parsed.name] = entry.to_dict()
    save_registry_atomic(store_dir, reg)
    print(f"Added shortcut '{parsed.name}'.")
    return 0


def cmd_link(args: List[str]) -> int:
    parser = argparse.ArgumentParser(prog="shortcut link", description="Link an external script to shortcut store")
    parser.add_argument("name", help="Shortcut name")
    parser.add_argument("path", help="Path to existing script")
    parser.add_argument("--desc", required=True, help="Shortcut description")
    parser.add_argument("--static", default=None, help="Static directory for global scope")
    parser.add_argument("--local", action="store_true", help="Store locally in nearest project")
    parser.add_argument("--by", default=None, help="Creator identifier")

    parsed = parser.parse_args(args)
    cwd = os.getcwd()
    store_dir, static_target = choose_target_store(parsed.name, parsed.static, parsed.local, cwd)

    reg = load_registry(store_dir) if registry_exists(store_dir) else {"version": 1, "shortcuts": {}}
    shortcuts = reg.setdefault("shortcuts", {})
    if parsed.name in shortcuts:
        die(f"Shortcut '{parsed.name}' already exists in store {store_dir}")

    abs_path = os.path.abspath(os.path.expanduser(parsed.path))
    if not os.path.isfile(abs_path):
        die(f"Target script does not exist: {abs_path}")

    today = date.today().isoformat()
    entry = ShortcutEntry(
        name=parsed.name,
        description=parsed.desc,
        script=abs_path,
        dir=static_target,
        created_by=parsed.by,
        created=today,
    )
    shortcuts[parsed.name] = entry.to_dict()
    save_registry_atomic(store_dir, reg)
    print(f"Linked shortcut '{parsed.name}'.")
    return 0


def cmd_list(args: List[str]) -> int:
    parser = argparse.ArgumentParser(prog="shortcut list", description="List available shortcuts")
    parser.add_argument("--names", action="store_true", help="Print bare visible names only")
    parsed = parser.parse_args(args)

    cwd = os.getcwd()
    local_dir = find_local_store_dir(cwd)
    local_items: List[Tuple[str, str, str]] = []  # (name, scope, desc)
    project_root = os.path.dirname(local_dir) if local_dir else None

    if local_dir and registry_exists(local_dir):
        local_reg = load_registry(local_dir)
        for name, data in sorted(local_reg.get("shortcuts", {}).items()):
            desc = data.get("description", "")
            local_items.append((name, "local", desc))

    global_dir = get_global_store_dir()
    global_items: List[Tuple[str, str, str]] = []
    global_prefixes: Dict[str, str] = {}
    if registry_exists(global_dir):
        global_reg = load_registry(global_dir)
        global_prefixes = global_reg.get("prefixes", {})
        for name, data in sorted(global_reg.get("shortcuts", {}).items()):
            if any(name.startswith(p) for p in RESERVED_PREFIXES):
                scope = "global"
            elif any(name.startswith(p) for p in global_prefixes):
                scope = "prefix"
            elif data.get("dir"):
                scope = "static"
            else:
                scope = "global"
            desc = data.get("description", "")
            global_items.append((name, scope, desc))

    if parsed.names:
        seen: Set[str] = set()
        for name, _, _ in local_items:
            if name not in seen:
                seen.add(name)
                print(name)
        for name, _, _ in global_items:
            if name not in seen:
                seen.add(name)
                print(name)
        return 0

    # lazy: simple column formatting with fixed widths; upgrade to tabulate if richer formatting is needed
    if local_items:
        print(f"Local shortcuts ({project_root}):")
        for name, scope, desc in local_items:
            print(f"  {name:<20} {scope:<10} {desc}")
        if global_items or global_prefixes:
            print()

    if global_items:
        print("Global shortcuts:")
        for name, scope, desc in global_items:
            print(f"  {name:<20} {scope:<10} {desc}")
        if global_prefixes:
            print()

    if global_prefixes:
        print("Prefixes:")
        for p, d in sorted(global_prefixes.items()):
            print(f"  {p:<20} -> {d}")

    return 0


